# LLM configuration
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# OntoPortal REST credentials
ONTOPORTAL_API_BASE=https://rest.matportal.org
ONTOPORTAL_API_KEY=

# OntoPortal RAG API
RAG_BASE_URL=http://localhost:8000
RAG_QUERY_PATH=/api/v1/query

# Model Context Protocol endpoints (comma separated)
MCP_ENDPOINTS=http://localhost:8000/mcp

# Workspace directories
ONTOLOGY_WORKDIR=/tmp/ontoportal-agent
