# LLM configuration
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# OntoPortal REST credentials (required by the assistant MCP bridge)
ONTOPORTAL_API_BASE=https://rest.matportal.org
ONTOPORTAL_API_KEY=replace-me

# OntoPortal RAG API
RAG_BASE_URL=http://localhost:8000
RAG_QUERY_PATH=/api/v1/query

# Model Context Protocol endpoints (comma separated)
MCP_ENDPOINTS=http://localhost:8000/mcp
MCP_API_KEY=change-me
MCP_RAG_TOOL_NAME=rag_query

# Required before exposing /api/v1/me/* or either chat stream.
# Generate independent random values; leave blank until configured.
INTERNAL_API_TOKEN=
USER_CONTEXT_SECRET=
ENCRYPTION_KEY_CURRENT=

# Workspace directories
ONTOLOGY_WORKDIR=/tmp/ontoportal-agent
